# CashNest X Cloudflare Worker KV deploy output example
# The real .env.cloudflare.worker file is generated by:
# ./scripts/deploy-cloudflare-worker-termux.sh
# Do not commit the real file because it contains CASHNEST_BACKUP_KEY.

# Add these VITE_ values to the app .env or GitHub Actions secrets.
VITE_CLOUDFLARE_WORKER_URL=https://cashnest-x-backup-api.your-workers-subdomain.workers.dev
VITE_CLOUDFLARE_BACKUP_KEY=replace-with-generated-backup-key
VITE_FIREBASE_PROJECT_ID=replace-with-firebase-project-id

# Used by the deploy/test scripts and Worker secrets.
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
WORKER_NAME=cashnest-x-backup-api
KV_NAMESPACE=cashnest-x-backups
KV_NAMESPACE_ID=replace-with-kv-namespace-id
WORKERS_SUBDOMAIN=your-workers-subdomain
CASHNEST_BACKUP_KEY=replace-with-generated-backup-key
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
