# CashNest X environment example
# Copy to .env for local testing, or add the same keys as GitHub Actions secrets.
# Do not commit a real .env file.

# App identity
VITE_APP_NAME=CashNest X
VITE_APP_PACKAGE_NAME=com.cashnest_x.pub

# Firebase Google login
VITE_ENABLE_FIREBASE_AUTH=true
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
VITE_FIREBASE_AUTH_DOMAIN=replace-with-firebase-project-id.firebaseapp.com
VITE_FIREBASE_WEB_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com

# Backward-compatible alias used by older workflow/native plugin code.
# Use the same Web Client ID value here.
VITE_ENABLE_GOOGLE_BACKUP=true
VITE_GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com

# Cloudflare Workers KV backup only
VITE_CLOUDFLARE_WORKER_URL=https://cashnest-x-backup-api.your-workers-subdomain.workers.dev
VITE_CLOUDFLARE_BACKUP_KEY=replace-with-generated-backup-key

# Optional private GitHub release updater
# VITE_GITHUB_TOKEN=github-fine-grained-read-token
